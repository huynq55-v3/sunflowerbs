# SunflowerBS — biến môi trường (Vite). Chỉ biến VITE_ được đưa vào bundle.

# Định danh workspace — mọi client cùng group tìm cùng Directory P2P.
VITE_GROUP_ID=sunflower-workspace-01

# URL relay WebSocket để đồng bộ chéo thiết bị/trình duyệt (chạy: npm run relay).
VITE_SYNC_SERVER_URL=ws://localhost:4400

# Tên database IndexedDB local.
VITE_DB_NAME=sunflowerbs
VITE_DB_ACCOUNTS_STORE=accounts
